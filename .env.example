# --- App ---
APP_NAME=FansTech
APP_HOST=localhost
APP_PORT=3000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
NODE_ENV=development

# --- CORS (comma-separated; falls back to localhost defaults) ---
CORS_ALLOWED_ORIGINS=

# --- Postgres / TypeORM ---
TYPEORM_DB_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=postgres
TYPEORM_DATABASE=fanstech
TYPEORM_LOGGING=false
TYPEORM_SSL=false
TYPEORM_MIGRATIONS_RUN=false
TYPEORM_MIGRATIONS_TABLE_NAME=migrations

# --- Auth ---
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=7d

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
