# --- App ---
APP_NAME=FansTech
APP_HOST=localhost
APP_PORT=3000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
NODE_ENV=development

# --- CORS (comma-separated; falls back to localhost defaults) ---
CORS_ALLOWED_ORIGINS=

# --- Postgres / TypeORM ---
TYPEORM_DB_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=postgres
TYPEORM_DATABASE=fanstech
TYPEORM_LOGGING=false
TYPEORM_SSL=false
TYPEORM_MIGRATIONS_RUN=false
TYPEORM_MIGRATIONS_TABLE_NAME=migrations

# --- Auth ---
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=7d

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Redis / BullMQ (durable jobs) ---
# When unset, the app boots on the Redis-free CronScheduler fallback.
REDIS_URL=redis://localhost:6379
# If 'false', this process enqueues jobs but does NOT run processors/reconciler
# (API-only). The dedicated worker process runs with RUN_WORKERS=true.
RUN_WORKERS=true

# --- Chain / web3 (Phase 2). Unset = app stays fully web2. ---
CHAIN_RPC_URL=
CHAIN_ID=11155111
CHAIN_DEPLOY_BLOCK=11193463
# Optional per-network address overrides: ADDR_FANS, ADDR_CLUB_FACTORY, ADDR_FANS_SWAP, ...

# --- Uniswap v4 (Sepolia) ---
ADDR_POOL_MANAGER=
ADDR_FANS_HOOK=
ADDR_FANS_V4_ROUTER=
ADDR_FANS_LP_VAULT=
